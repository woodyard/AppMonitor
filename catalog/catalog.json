[
  {
    "appId": "7zip",
    "displayName": "7-Zip",
    "source": "winget",
    "context": "auto",
    "wingetId": "7zip.7zip",
    "versionUrl": "https://www.7-zip.org/download.html",
    "versionRegex": "Download 7-Zip (\\d+\\.\\d+)",
    "downloadUrl": "https://www.7-zip.org/a/7z{version_nodots}-x64.exe",
    "installerArgs": "/S",
    "installerType": "exe",
    "detectDisplayNameRegex": "^7-Zip\\b",
    "processNames": [ "7zFM", "7zG", "7z" ],
    "notes": "Web fallback verified 2026-09-14: version page lists 26.03, https://www.7-zip.org/a/7z2603-x64.exe returns 200."
  },
  {
    "appId": "notepadplusplus",
    "displayName": "Notepad++",
