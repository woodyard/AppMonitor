    "versionUrl": "https://api.github.com/repos/PowerShell/PowerShell/releases/latest",
    "versionRegex": "\"tag_name\":\\s*\"v?([^\"]+)\"",
    "downloadUrl": "https://github.com/PowerShell/PowerShell/releases/download/v{version}/PowerShell-{version}-win-x64.msi",
    "installerArgs": "",
