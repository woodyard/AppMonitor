  },
  {
    "appId": "git",
    "displayName": "Git",
    "source": "winget",
    "context": "system",
    "wingetId": "Git.Git",
    "detectDisplayNameRegex": "^Git\\b",
    "detectPublisherRegex": "The Git Development Community",
    "processNames": [ "git-bash", "git", "bash" ],
    "notes": "winget only - git-scm.com has no stable machine-readable version endpoint that survives a release rename."
  },
  {
    "appId": "zoom",
    "displayName": "Zoom Workplace",
    "source": "winget",
    "context": "auto",
    "wingetId": "Zoom.Zoom",
    "detectDisplayNameRegex": "^Zoom\\b",
    "processNames": [ "Zoom", "Zoom.exe" ],
    "notes": "winget only. Zoom installs per-user by default and machine-wide with the MSI, hence context auto."
  },
  {
    "appId": "acrobatreader",
    "displayName": "Adobe Acrobat Reader",
    "source": "winget",
    "context": "system",
    "wingetId": "Adobe.Acrobat.Reader.64-bit",
    "detectDisplayNameRegex": "^Adobe Acrobat",
    "processNames": [ "Acrobat", "AcroRd32" ],
    "notes": "winget only - Adobe's download endpoints require a session token."
  },
  {
    "appId": "teams",
    "displayName": "Microsoft Teams",
    "source": "winget",
    "context": "auto",
    "wingetId": "Microsoft.Teams",
    "detectDisplayNameRegex": "^Microsoft Teams(?! Meeting Add-in)",
    "processNames": [ "ms-teams", "Teams" ],
    "notes": "winget only. New Teams is an MSIX; the machine-wide bootstrapper keeps it current, so updates are usually a no-op."
  },
  {
    "appId": "slack",
    "displayName": "Slack",
    "source": "winget",
    "context": "user",
    "wingetId": "SlackTechnologies.Slack",
    "detectDisplayNameRegex": "^Slack\\b",
    "processNames": [ "slack" ],
    "notes": "winget only. Slack's default installer is per-user, so the tray agent owns this app."
  }
]
