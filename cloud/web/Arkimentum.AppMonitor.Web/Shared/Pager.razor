@* Previous / next over a PagedResult, with the range it is showing. *@

<div class="pager">
    <span class="muted">@RangeText</span>
    <span class="pager-buttons">
        <button type="button" class="btn btn-quiet" disabled="@(Page <= 1 || Disabled)" @onclick="() => GoAsync(Page - 1)">Previous</button>
        <button type="button" class="btn btn-quiet" disabled="@(Page >= LastPage || Disabled)" @onclick="() => GoAsync(Page + 1)">Next</button>
    </span>
</div>

@code {
    [Parameter] public int Page { get; set; } = 1;

    [Parameter] public int PageSize { get; set; } = 50;

    [Parameter] public int Total { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private int LastPage => Total <= 0 ? 1 : (Total + PageSize - 1) / PageSize;

    private string RangeText
    {
        get
        {
            if (Total <= 0) return "Nothing to show";
            var first = ((Page - 1) * PageSize) + 1;
            var last = Math.Min(Page * PageSize, Total);
            return $"{first}–{last} of {Total}";
        }
    }

    private Task GoAsync(int page)
    {
        if (page < 1 || page > LastPage) return Task.CompletedTask;
        return PageChanged.InvokeAsync(page);
    }
}
