<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>Arkimentum.AppMonitor.Admin</RootNamespace>
    <AssemblyName>Arkimentum.AppMonitor.Admin</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- The manifest requests asInvoker, not requireAdministrator: App.OnStartup elevates the process itself with
         ShellExecute "runas", which keeps the unprivileged user-config testing mode free of any UAC prompt.
         Keep the manifest free of XML comments outside <compatibility>: the SxS loader rejects the executable
         ("side-by-side configuration is incorrect") when a comment precedes <assembly> or sits inside <security>. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Application.ThemeMode (WPF Fluent theme) is still marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!-- Service state and Start/Stop/Restart on the Overview page. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
    <!-- Entra ID sign-in for the organization pages: MSAL plus its cross-platform persistent token cache
         (%LOCALAPPDATA%\Arkimentum\AppMonitor\msal.cache, DPAPI-encrypted for the current user). -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.89.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.89.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Arkimentum.AppMonitor.Core\Arkimentum.AppMonitor.Core.csproj" />
    <!-- The Arkimentum brand theme: palettes, styles, the Gelasio wordmark font and BrandHeader. -->
    <ProjectReference Include="..\Arkimentum.AppMonitor.UI\Arkimentum.AppMonitor.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- <ApplicationIcon> needs the file on disk; XAML uses the UI library's copy (BrandAssets.AppIconUri). -->
    <Resource Include="Assets\**\*.ico" />
  </ItemGroup>
</Project>
