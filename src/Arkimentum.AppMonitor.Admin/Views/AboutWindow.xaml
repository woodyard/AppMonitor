<Window x:Class="Arkimentum.AppMonitor.Admin.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Arkimentum.AppMonitor.Admin.Resources"
        xmlns:ui="clr-namespace:Arkimentum.AppMonitor.UI;assembly=Arkimentum.AppMonitor.UI"
        Title="{Binding Title}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Arkimentum.AppMonitor.UI;component/Assets/app.ico"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{DynamicResource BrandInkBrush}"
        Background="{DynamicResource BrandBackgroundBrush}">

    <StackPanel Margin="24,20,24,20">

        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Arkimentum.AppMonitor.UI;component/Assets/app.ico"
                   Width="56"
                   Height="56"
                   Margin="0,0,16,0"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <!-- No brand rule here: the app icon beside the wordmark already carries the two bars. -->
            <StackPanel VerticalAlignment="Center">
                <ui:BrandHeader ShowBrandRule="False"
                                WordmarkFontSize="26"
                                BrandName="{x:Static res:Strings.WordmarkBrand}"
                                ProductName="{x:Static res:Strings.WordmarkProduct}"
                                Subtitle="{Binding VersionText}"
                                SubtitleMargin="0,10,0,0" />
                <TextBlock Style="{StaticResource TertiaryCaptionText}" Margin="0,2,0,0" Text="{Binding Copyright}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Style="{StaticResource BodyText}" Margin="0,24,0,0" Text="{Binding Description}" />

        <TextBlock Style="{StaticResource GroupHeaderText}" Margin="0,24,0,8" Text="{Binding CommandLineHeader}" />
        <Border Style="{StaticResource SubtleCard}" Padding="16">
            <ItemsControl ItemsSource="{Binding Switches}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource CaptionText}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Margin="0,0,0,6"
                                   Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Style="{StaticResource SubtleCard}" Margin="0,16,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="{x:Static res:Strings.LabelConfigurationKey}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" TextWrapping="Wrap" Text="{Binding ConfigurationKey}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0" Text="Catalog" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding CatalogPath}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0" Text="{x:Static res:Strings.AboutLogFolder}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource DetailValue}" TextWrapping="Wrap" Text="{Binding LogDirectory}" />
                    <Button Style="{StaticResource LinkButton}"
                            Margin="0,4,0,0"
                            Content="{Binding OpenText}"
                            Command="{Binding OpenLogFolderCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Button HorizontalAlignment="Right"
                MinWidth="104"
                Margin="0,24,0,0"
                Padding="16,8"
                IsCancel="True"
                IsDefault="True"
                Style="{DynamicResource AccentButtonStyle}"
                Content="{Binding CloseText}"
                Command="{Binding CloseCommand}" />
    </StackPanel>
</Window>
