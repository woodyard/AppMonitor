<UserControl x:Class="Arkimentum.AppMonitor.Admin.Views.ApplicationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Arkimentum.AppMonitor.Admin.Resources"
             FontFamily="{StaticResource AppFontFamily}"
             Foreground="{DynamicResource BrandInkBrush}">

    <!-- Master/detail. The detail editor is generated from SettingsSchema.App, exactly like the Settings page. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource PageTitleText}" Text="{Binding Title}" />
            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      Style="{StaticResource ToggleSwitch}"
                      Content="{x:Static res:Strings.ShowAdvanced}"
                      IsChecked="{Binding Editor.ShowAdvanced, Mode=TwoWay}" />
        </Grid>

        <WrapPanel Grid.Row="1" Margin="4,0,4,16">
            <Button Padding="12,6" Margin="0,0,8,0" FontSize="13"
                    Content="{x:Static res:Strings.AddFromCatalog}"
                    ToolTip="{x:Static res:Strings.TipAddFromCatalog}"
                    Command="{Binding AddFromCatalogCommand}" />
            <Button Padding="12,6" Margin="0,0,8,0" FontSize="13"
                    Content="{x:Static res:Strings.DiscoverInstalled}"
                    ToolTip="{x:Static res:Strings.TipDiscoverInstalled}"
                    Command="{Binding DiscoverCommand}" />
            <Button Padding="12,6" Margin="0,0,8,0" FontSize="13"
                    Content="{x:Static res:Strings.AddCustom}"
                    ToolTip="{x:Static res:Strings.TipAddCustom}"
                    Command="{Binding AddCustomCommand}" />
            <Button Padding="12,6" Margin="0,0,8,0" FontSize="13"
                    Content="{x:Static res:Strings.Duplicate}"
                    ToolTip="{x:Static res:Strings.TipDuplicate}"
                    Command="{Binding DuplicateCommand}" />
            <Button Padding="12,6" Margin="0,0,8,0" FontSize="13"
                    Content="{x:Static res:Strings.Remove}"
                    ToolTip="{x:Static res:Strings.TipRemove}"
                    Command="{Binding RemoveCommand}" />

            <!-- result line of the last bulk add -->
            <TextBlock Style="{StaticResource SuccessText}"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding Notice}"
                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==== master -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="4,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- WPF has no placeholder property; the caption sits behind the box and hides once it is typed in. -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{x:Static res:Strings.FilterPlaceholder}"
                                 AutomationProperties.Name="{x:Static res:Strings.FilterPlaceholder}" />
                        <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="{x:Static res:Strings.FilterPlaceholder}"
                                   Visibility="{Binding Filter, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Style="{StaticResource TertiaryCaptionText}"
                               Text="{x:Static res:Strings.NoAppsConfigured}"
                               Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <ListBox Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding VisibleApps}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource AppListItem}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="{x:Static res:Strings.ApplicationsTitle}"
                             Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource BodyStrongText}"
                                                   FontSize="13"
                                                   Margin="0,0,8,0"
                                                   Text="{Binding DisplayName}" />
                                        <Border Grid.Column="1"
                                                Style="{StaticResource PolicyBadge}"
                                                Visibility="{Binding IsPolicyOnly, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource PolicyBadgeText}" Text="{x:Static res:Strings.BadgePolicy}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Text="{Binding SummaryLine}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding EnabledText}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}"
                                                Margin="4,0,0,0"
                                                Background="{DynamicResource BrandTerracottaSurfaceBrush}"
                                                Visibility="{Binding IsMandatory, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource BadgeText}"
                                                       Foreground="{DynamicResource BrandTerracottaTextBrush}"
                                                       Text="{Binding MandatoryText}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ==== detail -->
            <Grid Grid.Column="2">
                <TextBlock Style="{StaticResource TertiaryCaptionText}"
                           VerticalAlignment="Top"
                           Text="{x:Static res:Strings.NoAppSelected}"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0"
                              DataContext="{Binding Selected}"
                              Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,4,24">

                        <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SubtitleText}" FontSize="17" Text="{Binding DisplayName}" />
                                    <Border Style="{StaticResource PolicyBadge}"
                                            Margin="12,4,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsPolicyOnly, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource PolicyBadgeText}" Text="{x:Static res:Strings.BadgePolicy}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource TertiaryCaptionText}" Margin="0,4,0,0" Text="{Binding AppId}" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource BrandGoldTextBrush}"
                                           Text="{x:Static res:Strings.PolicyAppHint}"
                                           Visibility="{Binding IsPolicyOnly, Converter={StaticResource BoolToVisibility}}" />

                                <!-- ==== test detection -->
                                <StackPanel Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Padding="14,7"
                                                Content="{x:Static res:Strings.TestDetection}"
                                                Command="{Binding TestDetectionCommand}" />
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{x:Static res:Strings.TestDetectionRunning}"
                                                   Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                               Margin="0,8,0,0"
                                               MaxWidth="620"
                                               HorizontalAlignment="Left"
                                               Text="{x:Static res:Strings.TestDetectionCaption}" />

                                    <Grid Margin="0,12,0,0"
                                          Visibility="{Binding HasDetectionResult, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="{x:Static res:Strings.LabelInstalledVersion}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding DetectionInstalledVersion}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,6,16,0" Text="{x:Static res:Strings.LabelAvailableVersion}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,6,0,0" Text="{Binding DetectionAvailableVersion}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,6,16,0" Text="{x:Static res:Strings.LabelDetectionResult}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding DetectionMessage}" />

                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                                                   Style="{StaticResource TertiaryCaptionText}"
                                                   Margin="0,8,0,0"
                                                   Text="{x:Static res:Strings.TestDetectionUnsavedCaption}"
                                                   Visibility="{Binding DetectionUsedEditorValues, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource SettingGroupTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
