<Window x:Class="Arkimentum.AppMonitor.Admin.Views.CatalogPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Arkimentum.AppMonitor.Admin.Resources"
        Title="{Binding Title}"
        Width="620"
        Height="560"
        MinWidth="480"
        MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Arkimentum.AppMonitor.UI;component/Assets/app.ico"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{DynamicResource BrandInkBrush}"
        Background="{DynamicResource BrandBackgroundBrush}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SubtitleText}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" Text="{Binding Subtitle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <TextBox Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{x:Static res:Strings.FilterPlaceholder}"
                     AutomationProperties.Name="{x:Static res:Strings.FilterPlaceholder}" />
            <TextBlock Style="{StaticResource TertiaryCaptionText}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Text="{x:Static res:Strings.FilterPlaceholder}"
                       Visibility="{Binding Filter, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
        </Grid>

        <TextBlock Grid.Row="2"
                   Style="{StaticResource TertiaryCaptionText}"
                   Text="{Binding EmptyText}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="8"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="4,6"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding DisplayName}">
                                <StackPanel Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyStrongText}" FontSize="13" Text="{Binding DisplayName}" />
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding SourceText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource TertiaryCaptionText}" Margin="0,2,0,0" Text="{Binding AppId}" />
                                    <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Text="{Binding Detail}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="{Binding SelectedText}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="104"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="{Binding CancelText}"
                        Command="{Binding CancelCommand}" />
                <Button MinWidth="104"
                        Padding="16,8"
                        IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}"
                        Content="{Binding AcceptText}"
                        Command="{Binding AcceptCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
