<UserControl x:Class="Arkimentum.AppMonitor.Admin.Views.CloudConnectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Arkimentum.AppMonitor.Admin.Resources"
             FontFamily="{StaticResource AppFontFamily}"
             Foreground="{DynamicResource BrandInkBrush}">

    <!-- Server URL -> sign-in configuration -> Entra ID token -> /admin/me -> organization. Each step shows what it
         knows, so a failure can be read off the page rather than out of the log. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Margin="4,0,4,24">

            <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource CaptionText}" MaxWidth="700" HorizontalAlignment="Left" Margin="0,0,0,16"
                       Text="{Binding Subtitle}" />

            <!-- ==== server and sign-in -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static res:Strings.CardSignIn}" />

                    <TextBlock Style="{StaticResource DetailLabel}" Margin="0,0,0,4" Text="{x:Static res:Strings.LabelServerUrl}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 MaxWidth="560"
                                 HorizontalAlignment="Stretch"
                                 Text="{Binding ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                 AutomationProperties.Name="{x:Static res:Strings.LabelServerUrl}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Padding="14,7"
                                    Content="{x:Static res:Strings.ButtonConnect}"
                                    ToolTip="{x:Static res:Strings.TipConnect}"
                                    Command="{Binding ConnectCommand}" />
                            <Button Margin="8,0,0,0"
                                    Padding="14,7"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Content="{x:Static res:Strings.ButtonSignIn}"
                                    ToolTip="{x:Static res:Strings.TipSignIn}"
                                    Command="{Binding SignInCommand}"
                                    IsDefault="True" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource TertiaryCaptionText}" Margin="0,6,0,0" Text="{Binding ServerUrlSource}" />

                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,0" Text="{Binding StatusText}" />

                    <Border Style="{StaticResource CriticalBanner}"
                            Margin="0,12,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SymbolGlyph}"
                                       FontSize="14"
                                       Margin="0,1,10,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource BrandTerracottaTextBrush}"
                                       Text="{x:Static res:Strings.GlyphError}" />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       MaxWidth="620"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource BrandTerracottaTextBrush}"
                                       Text="{Binding Error}" />
                        </StackPanel>
                    </Border>

                    <!-- what the server told us to sign in with, and who we ended up as -->
                    <Grid Margin="0,16,0,0" Visibility="{Binding HasAuthConfig, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="{x:Static res:Strings.LabelAuthority}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" TextWrapping="Wrap" Text="{Binding AuthorityText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0" Text="{x:Static res:Strings.LabelScope}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ScopeText}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0" Text="{x:Static res:Strings.LabelClientId}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding ClientIdText}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0"
                                   Text="{x:Static res:Strings.LabelSignedInAs}"
                                   Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource DetailValue}" VerticalAlignment="Center" Text="{Binding SignedInAs}" />
                            <Border Style="{StaticResource Badge}"
                                    Margin="8,0,0,0"
                                    Background="{DynamicResource BrandSkySurfaceBrush}"
                                    Visibility="{Binding IsGlobalAdmin, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource BadgeText}"
                                           Foreground="{DynamicResource BrandSkyTextBrush}"
                                           Text="{x:Static res:Strings.BadgeGlobalAdmin}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0"
                                   Text="{x:Static res:Strings.LabelTenant}"
                                   Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,8,0,0"
                                   Text="{Binding TenantText}"
                                   Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                        <Button Padding="14,7"
                                Content="{x:Static res:Strings.ButtonSignOut}"
                                ToolTip="{x:Static res:Strings.TipSignOut}"
                                Command="{Binding SignOutCommand}" />
                        <Button Margin="8,0,0,0"
                                Padding="14,7"
                                Content="{x:Static res:Strings.ButtonReloadOrganizations}"
                                Command="{Binding ReloadOrganizationsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==== organizations -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static res:Strings.CardOrganizations}" />

                    <TextBlock Style="{StaticResource TertiaryCaptionText}"
                               Text="{x:Static res:Strings.OrganizationsEmpty}"
                               Visibility="{Binding HasOrganizations, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <StackPanel Visibility="{Binding HasOrganizations, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8" Text="{x:Static res:Strings.OrganizationPickPrompt}" />

                        <ListBox Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="300"
                                 ItemsSource="{Binding Organizations}"
                                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource AppListItem}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="{x:Static res:Strings.CardOrganizations}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyStrongText}" FontSize="13" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource TertiaryCaptionText}" Margin="0,2,0,0" Text="{Binding Devices}" />
                                        <TextBlock Style="{StaticResource TertiaryCaptionText}" Margin="0,2,0,0" Text="{Binding OrganizationId}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Padding="14,7"
                                Style="{DynamicResource AccentButtonStyle}"
                                Content="{x:Static res:Strings.ButtonUseOrganization}"
                                Command="{Binding UseOrganizationCommand}"
                                Visibility="{Binding HasOrganizations, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Creating an organization is a global-administrator action; the button is simply not
                             there for anyone else, and the server checks the app role again. It sits outside the
                             list so a global administrator with no organizations yet can still get started. -->
                        <Button Margin="8,0,0,0"
                                Padding="14,7"
                                Content="{x:Static res:Strings.ButtonCreateOrganization}"
                                ToolTip="{x:Static res:Strings.TipCreateOrganization}"
                                Command="{Binding CreateOrganizationCommand}"
                                Visibility="{Binding IsGlobalAdmin, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
