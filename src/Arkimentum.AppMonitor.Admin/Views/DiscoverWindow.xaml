<Window x:Class="Arkimentum.AppMonitor.Admin.Views.DiscoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Arkimentum.AppMonitor.Admin.Resources"
        Title="{Binding Title}"
        Width="820"
        Height="680"
        MinWidth="620"
        MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Arkimentum.AppMonitor.UI;component/Assets/app.ico"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{DynamicResource BrandInkBrush}"
        Background="{DynamicResource BrandBackgroundBrush}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource SubtitleText}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" Text="{Binding Subtitle}" />
        </StackPanel>

        <!-- ==== filter row, hidden while the scan is running -->
        <Grid Grid.Row="1"
              Margin="0,16,0,12"
              Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,16,0">
                <TextBox Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static res:Strings.FilterPlaceholder}"
                         AutomationProperties.Name="{x:Static res:Strings.FilterPlaceholder}" />
                <TextBlock Style="{StaticResource TertiaryCaptionText}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Text="{x:Static res:Strings.FilterPlaceholder}"
                           Visibility="{Binding Filter, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
            </Grid>

            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      Style="{StaticResource ToggleSwitch}"
                      Content="{Binding OnlyAddableText}"
                      IsChecked="{Binding OnlyAddable, Mode=TwoWay}" />
        </Grid>

        <!-- ==== progress while winget is being asked (a few seconds) -->
        <StackPanel Grid.Row="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar IsIndeterminate="True" Width="280" Height="4" />
            <TextBlock Style="{StaticResource CaptionText}"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       Text="{Binding Progress}" />
        </StackPanel>

        <Border Grid.Row="2"
                Style="{StaticResource CriticalBanner}"
                VerticalAlignment="Top"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource BodyText}"
                       Foreground="{DynamicResource BrandTerracottaTextBrush}"
                       Text="{Binding Error}" />
        </Border>

        <TextBlock Grid.Row="2"
                   VerticalAlignment="Top"
                   Text="{Binding EmptyText}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TertiaryCaptionText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowList}" Value="True" />
                                <Condition Binding="{Binding ShowEmpty}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- ==== the result list, in the order Core delivered -->
        <Border Grid.Row="2" Padding="8">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowList}" Value="True" />
                                <Condition Binding="{Binding ShowEmpty}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="4,6"
                                      VerticalContentAlignment="Top"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanSelect}"
                                      AutomationProperties.Name="{Binding DisplayName}">
                                <StackPanel Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyStrongText}" FontSize="13" Text="{Binding DisplayName}" />
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding ContextText}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}"
                                                Margin="4,0,0,0"
                                                Background="{DynamicResource BrandPrimarySurfaceBrush}"
                                                Visibility="{Binding IsInCatalog, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource BadgeText}"
                                                       Foreground="{DynamicResource BrandPrimaryTextBrush}"
                                                       Text="{Binding CatalogBadge}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}"
                                                Margin="4,0,0,0"
                                                Background="{DynamicResource BrandSkySurfaceBrush}"
                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource BadgeText}"
                                                       Foreground="{DynamicResource BrandSkyTextBrush}"
                                                       Text="{Binding UpdateBadge}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Style="{StaticResource TertiaryCaptionText}" Text="{Binding Version}" />
                                        <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                                   Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   Text="{Binding Publisher}"
                                                   Visibility="{Binding HasPublisher, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Text="{Binding WingetText}" />

                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource BrandGoldTextBrush}"
                                               Text="{Binding ConfiguredText}"
                                               Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ==== footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Padding="12,6"
                        Margin="0,0,8,0"
                        Content="{Binding SelectAllText}"
                        Command="{Binding SelectAllCommand}" />
                <Button Padding="12,6"
                        Margin="0,0,16,0"
                        Content="{Binding SelectNoneText}"
                        Command="{Binding SelectNoneCommand}" />
                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center" Text="{Binding SelectedText}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="104"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="{Binding CancelText}"
                        Command="{Binding CancelCommand}" />
                <Button MinWidth="120"
                        Padding="16,8"
                        IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}"
                        Content="{Binding AcceptText}"
                        Command="{Binding AcceptCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
