<UserControl x:Class="Arkimentum.AppMonitor.Admin.Views.OrganizationActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Arkimentum.AppMonitor.Admin.Resources"
             FontFamily="{StaticResource AppFontFamily}"
             Foreground="{DynamicResource BrandInkBrush}">

    <!-- The organization's event feed, newest first. Deliberately plain: the per-device story is on Devices. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource CaptionText}" MaxWidth="700" HorizontalAlignment="Left" Text="{Binding Subtitle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Padding="8,4"
                    Command="{Binding RefreshCommand}"
                    ToolTip="{x:Static res:Strings.ButtonRefresh}"
                    AutomationProperties.Name="{x:Static res:Strings.ButtonRefresh}">
                <TextBlock Style="{StaticResource SymbolGlyph}"
                           FontSize="14"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                           Text="{x:Static res:Strings.GlyphRefresh}" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="4,0,4,12">
            <Border Style="{StaticResource InfoBanner}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource CaptionText}" Text="{x:Static res:Strings.SignInFirst}" />
            </Border>
            <Border Style="{StaticResource CriticalBanner}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource BrandTerracottaTextBrush}"
                           Text="{Binding Error}" />
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="4,0,4,24"
                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" MinWidth="140" />
                        <ColumnDefinition Width="*" MinWidth="100" />
                        <ColumnDefinition Width="1.3*" MinWidth="120" />
                        <ColumnDefinition Width="*" MinWidth="100" />
                        <ColumnDefinition Width="2.6*" MinWidth="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnDevice}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnWhen}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnEvent}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnApplication}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnMessage}" />
                </Grid>

                <TextBlock Grid.Row="1"
                           Style="{StaticResource TertiaryCaptionText}"
                           Text="{x:Static res:Strings.ActivityEmpty}"
                           Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Events}" Margin="0,0,8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.6*" MinWidth="140" />
                                            <ColumnDefinition Width="*" MinWidth="100" />
                                            <ColumnDefinition Width="1.3*" MinWidth="120" />
                                            <ColumnDefinition Width="*" MinWidth="100" />
                                            <ColumnDefinition Width="2.6*" MinWidth="180" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource TableCellText}" Margin="0,0,8,0"
                                                   FontWeight="SemiBold" Text="{Binding DeviceName}" ToolTip="{Binding DeviceName}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource TableCellText}" Margin="0,0,8,0"
                                                   ToolTip="{Binding WhenTooltip}" Text="{Binding When}" />
                                        <!-- A failed install is the one row an administrator is looking for. -->
                                        <TextBlock Grid.Column="2" Margin="0,0,8,0" Text="{Binding Kind}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrandTerracottaTextBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Style="{StaticResource TableCellText}" Margin="0,0,8,0" Text="{Binding AppId}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource TableCellText}" Text="{Binding Message}" ToolTip="{Binding Message}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Padding="10,5" FontSize="12"
                            Content="{x:Static res:Strings.ButtonPreviousPage}"
                            Command="{Binding PreviousPageCommand}" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource TertiaryCaptionText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{Binding PageText}" />
                    <Button Grid.Column="2" Padding="10,5" FontSize="12"
                            Content="{x:Static res:Strings.ButtonNextPage}"
                            Command="{Binding NextPageCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
