<UserControl x:Class="Arkimentum.AppMonitor.Admin.Views.OrganizationDevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Arkimentum.AppMonitor.Admin.Resources"
             FontFamily="{StaticResource AppFontFamily}"
             Foreground="{DynamicResource BrandInkBrush}">

    <!-- Master/detail over the organization's devices. Everything in the detail pane is what the device last
         reported; the buttons queue commands it picks up on its next sync. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource CaptionText}" MaxWidth="640" HorizontalAlignment="Left" Text="{Binding Subtitle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    VerticalAlignment="Top"
                    Padding="8,4"
                    Command="{Binding RefreshCommand}"
                    ToolTip="{x:Static res:Strings.ButtonRefresh}"
                    AutomationProperties.Name="{x:Static res:Strings.ButtonRefresh}">
                <TextBlock Style="{StaticResource SymbolGlyph}"
                           FontSize="14"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                           Text="{x:Static res:Strings.GlyphRefresh}" />
            </Button>
        </Grid>

        <!-- ==== not signed in / error / notice -->
        <StackPanel Grid.Row="1" Margin="4,0,4,12">
            <Border Style="{StaticResource InfoBanner}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource CaptionText}" Text="{x:Static res:Strings.SignInFirst}" />
            </Border>
            <Border Style="{StaticResource CriticalBanner}"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource BrandTerracottaTextBrush}"
                           Text="{Binding Error}" />
            </Border>
            <TextBlock Style="{StaticResource SuccessText}"
                       Text="{Binding Notice}"
                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Grid Grid.Row="2" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==== master -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="4,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBox Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="{x:Static res:Strings.DevicesFilterPlaceholder}"
                                 AutomationProperties.Name="{x:Static res:Strings.DevicesFilterPlaceholder}" />
                        <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="{x:Static res:Strings.DevicesFilterPlaceholder}"
                                   Visibility="{Binding Search, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Style="{StaticResource TertiaryCaptionText}"
                               Text="{x:Static res:Strings.DevicesEmpty}"
                               Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <ListBox Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="{x:Static res:Strings.DevicesTitle}"
                             Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
                        <!-- AppListItem names itself from DisplayName; a device row calls it DeviceName. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource AppListItem}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding DeviceName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStrongText}" FontSize="13" Text="{Binding DeviceName}" />
                                    <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Text="{Binding SummaryLine}" />
                                    <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                               Margin="0,2,0,0"
                                               ToolTip="{Binding LastSeenTooltip}"
                                               Text="{Binding LastSeen}" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding AgentVersion}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Margin="4,0,0,0">
                                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Counts}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}"
                                                Margin="4,0,0,0"
                                                Background="{DynamicResource BrandGoldSurfaceBrush}"
                                                Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource BadgeText}"
                                                       Foreground="{DynamicResource BrandGoldTextBrush}"
                                                       Text="{Binding StaleBadge}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}"
                                                Margin="4,0,0,0"
                                                Background="{DynamicResource BrandTerracottaSurfaceBrush}"
                                                Visibility="{Binding PrerequisitesUnhealthy, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource BadgeText}"
                                                       Foreground="{DynamicResource BrandTerracottaTextBrush}"
                                                       Text="{Binding PrerequisiteBadge}" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Padding="10,5" FontSize="12"
                                Content="{x:Static res:Strings.ButtonPreviousPage}"
                                Command="{Binding PreviousPageCommand}" />
                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource TertiaryCaptionText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding PageText}" />
                        <Button Grid.Column="2" Padding="10,5" FontSize="12"
                                Content="{x:Static res:Strings.ButtonNextPage}"
                                Command="{Binding NextPageCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ==== detail -->
            <Grid Grid.Column="2">
                <TextBlock Style="{StaticResource TertiaryCaptionText}"
                           VerticalAlignment="Top"
                           Text="{x:Static res:Strings.NoDeviceSelected}"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,4,24">

                        <!-- summary and actions -->
                        <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubtitleText}" FontSize="17" Text="{Binding DeviceName}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="{x:Static res:Strings.LabelUser}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding UserText}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,6,16,0" Text="{x:Static res:Strings.LabelOs}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,6,0,0" Text="{Binding OsText}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,6,16,0" Text="{x:Static res:Strings.LabelAgentVersion}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,6,0,0" Text="{Binding AgentVersionText}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,6,16,0" Text="{x:Static res:Strings.LabelLastSeen}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,6,0,0" Text="{Binding LastSeenText}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,6,16,0" Text="{x:Static res:Strings.LabelEnrolled}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,6,0,0" Text="{Binding EnrolledText}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,6,16,0" Text="{x:Static res:Strings.LabelConfigVersion}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,6,0,0" Text="{Binding ConfigVersionText}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,6,16,0" Text="{x:Static res:Strings.LabelDeviceId}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding DeviceIdText}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Border Style="{StaticResource Badge}"
                                            Background="{DynamicResource BrandPrimarySurfaceBrush}"
                                            Visibility="{Binding PrerequisitesHealthy, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource BadgeText}"
                                                   Foreground="{DynamicResource BrandPrimaryTextBrush}"
                                                   Text="{x:Static res:Strings.PrerequisitesHealthy}" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}"
                                            Background="{DynamicResource BrandTerracottaSurfaceBrush}"
                                            Visibility="{Binding PrerequisitesHealthy, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Style="{StaticResource BadgeText}"
                                                   Foreground="{DynamicResource BrandTerracottaTextBrush}"
                                                   Text="{x:Static res:Strings.PrerequisitesUnhealthy}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               MaxWidth="480"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Text="{Binding PrerequisiteSummary}" />
                                </StackPanel>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Padding="14,7" Margin="0,8,8,0" FontSize="13"
                                            Content="{x:Static res:Strings.ButtonScanNowDevice}"
                                            ToolTip="{x:Static res:Strings.TipScanNowDevice}"
                                            Command="{Binding ScanNowCommand}" />
                                    <Button Padding="14,7" Margin="0,8,8,0" FontSize="13"
                                            Content="{x:Static res:Strings.ButtonReportNow}"
                                            ToolTip="{x:Static res:Strings.TipReportNow}"
                                            Command="{Binding ReportNowCommand}" />
                                    <Button Padding="14,7" Margin="0,8,8,0" FontSize="13"
                                            Content="{x:Static res:Strings.ButtonRepairDevice}"
                                            ToolTip="{x:Static res:Strings.TipRepairDevice}"
                                            Command="{Binding RepairPrerequisitesCommand}" />
                                    <Button Padding="14,7" Margin="0,8,8,0" FontSize="13"
                                            Content="{x:Static res:Strings.ButtonUpdateAgent}"
                                            ToolTip="{x:Static res:Strings.TipUpdateAgent}"
                                            Command="{Binding UpdateAgentCommand}" />
                                    <Button Padding="14,7" Margin="0,8,8,0" FontSize="13"
                                            Content="{x:Static res:Strings.ButtonDeleteDevice}"
                                            ToolTip="{x:Static res:Strings.TipDeleteDevice}"
                                            Command="{Binding DeleteDeviceCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- pending commands -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static res:Strings.CardPendingCommands}" />
                                <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                           Text="{x:Static res:Strings.PendingCommandsEmpty}"
                                           Visibility="{Binding HasPendingCommands, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <ItemsControl ItemsSource="{Binding PendingCommands}"
                                              Visibility="{Binding HasPendingCommands, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TableRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" MinWidth="140" />
                                                        <ColumnDefinition Width="*" MinWidth="110" />
                                                        <ColumnDefinition Width="2*" MinWidth="140" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource TableCellText}" FontWeight="SemiBold" Text="{Binding Kind}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource TableCellText}" Text="{Binding Issued}" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource TableCellText}" Text="{Binding IssuedBy}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- tracked updates -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static res:Strings.CardTrackedUpdates}" />
                                <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                           Text="{x:Static res:Strings.TrackedUpdatesEmpty}"
                                           Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <!-- The detail pane is narrow at the window's minimum size, so every table here scrolls
                                     sideways rather than silently cutting a column off. MinWidth on the inner grid is
                                     the sum of the column minimums. -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}">
                                    <Grid MinWidth="474">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="130" />
                                                <ColumnDefinition Width="2*" MinWidth="130" />
                                                <ColumnDefinition Width="*" MinWidth="72" />
                                                <ColumnDefinition Width="1.6*" MinWidth="108" />
                                                <ColumnDefinition Width="*" MinWidth="64" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnApplication}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnVersions}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnState}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnDeadline}" />
                                            <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnContext}" />
                                        </Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Updates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource TableRow}">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" MinWidth="130" />
                                                                    <ColumnDefinition Width="2*" MinWidth="130" />
                                                                    <ColumnDefinition Width="*" MinWidth="72" />
                                                                    <ColumnDefinition Width="1.6*" MinWidth="108" />
                                                                    <ColumnDefinition Width="*" MinWidth="64" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                                                    <TextBlock Style="{StaticResource TableCellText}" FontWeight="SemiBold"
                                                                               Text="{Binding DisplayName}" ToolTip="{Binding AppId}" />
                                                                    <!-- Mandatory is a badge, not a column: it is rare and reads better next to the name. -->
                                                                    <Border Style="{StaticResource Badge}"
                                                                            Margin="6,0,0,0"
                                                                            Background="{DynamicResource BrandTerracottaSurfaceBrush}"
                                                                            Visibility="{Binding IsMandatory, Converter={StaticResource BoolToVisibility}}">
                                                                        <TextBlock Style="{StaticResource BadgeText}"
                                                                                   Foreground="{DynamicResource BrandTerracottaTextBrush}"
                                                                                   Text="{x:Static res:Strings.BadgeMandatory}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Style="{StaticResource TableCellText}" Text="{Binding Versions}" />
                                                                <TextBlock Grid.Column="2" Style="{StaticResource TableCellText}" Text="{Binding State}" />
                                                                <TextBlock Grid.Column="3" Style="{StaticResource TableCellText}" Text="{Binding Deadline}" />
                                                                <TextBlock Grid.Column="4" Style="{StaticResource TableCellText}" Text="{Binding Context}" />
                                                            </Grid>
                                                            <TextBlock Style="{StaticResource ErrorText}"
                                                                       Margin="0,4,0,0"
                                                                       Text="{Binding LastError}"
                                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- recent events -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static res:Strings.CardRecentEvents}" />
                                <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                           Text="{x:Static res:Strings.RecentEventsEmpty}"
                                           Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}">
                                    <Grid MinWidth="470">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="95" />
                                                <ColumnDefinition Width="1.2*" MinWidth="115" />
                                                <ColumnDefinition Width="*" MinWidth="90" />
                                                <ColumnDefinition Width="2.4*" MinWidth="170" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnWhen}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnEvent}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnApplication}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnMessage}" />
                                        </Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Events}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource TableRow}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="95" />
                                                                <ColumnDefinition Width="1.2*" MinWidth="115" />
                                                                <ColumnDefinition Width="*" MinWidth="90" />
                                                                <ColumnDefinition Width="2.4*" MinWidth="170" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Style="{StaticResource TableCellText}" Margin="0,0,8,0" ToolTip="{Binding WhenTooltip}" Text="{Binding When}" />
                                                            <TextBlock Grid.Column="1" Style="{StaticResource TableCellText}" Margin="0,0,8,0" FontWeight="SemiBold" Text="{Binding Kind}" />
                                                            <TextBlock Grid.Column="2" Style="{StaticResource TableCellText}" Margin="0,0,8,0" Text="{Binding AppId}" />
                                                            <TextBlock Grid.Column="3" Style="{StaticResource TableCellText}" Text="{Binding Message}" ToolTip="{Binding Message}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- installed applications -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitleText}" Text="{x:Static res:Strings.CardInstalledApps}" />

                                <Grid Margin="0,0,0,12" MaxWidth="320" HorizontalAlignment="Left">
                                    <TextBox Text="{Binding InstalledFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{x:Static res:Strings.InstalledAppsFilter}"
                                             AutomationProperties.Name="{x:Static res:Strings.InstalledAppsFilter}" />
                                    <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Text="{x:Static res:Strings.InstalledAppsFilter}"
                                               Visibility="{Binding InstalledFilter, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                                </Grid>

                                <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                           Text="{x:Static res:Strings.InstalledAppsEmpty}"
                                           Visibility="{Binding HasInstalledApps, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                                <!-- The publisher is the tooltip of the name rather than a column: it is the least
                                     useful of the five and the widest. -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Visibility="{Binding HasInstalledApps, Converter={StaticResource BoolToVisibility}}">
                                    <Grid MinWidth="466">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.4*" MinWidth="160" />
                                                <ColumnDefinition Width="2*" MinWidth="130" />
                                                <ColumnDefinition Width="*" MinWidth="88" />
                                                <ColumnDefinition Width="*" MinWidth="88" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnApplication}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnWingetId}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnVersion}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnAvailable}" />
                                        </Grid>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding InstalledApps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource TableRow}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2.4*" MinWidth="160" />
                                                                <ColumnDefinition Width="2*" MinWidth="130" />
                                                                <ColumnDefinition Width="*" MinWidth="88" />
                                                                <ColumnDefinition Width="*" MinWidth="88" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                                                <TextBlock Style="{StaticResource TableCellText}" FontWeight="SemiBold"
                                                                           Text="{Binding DisplayName}" ToolTip="{Binding Publisher}" />
                                                                <Border Style="{StaticResource Badge}"
                                                                        Margin="6,0,0,0"
                                                                        Background="{DynamicResource BrandPrimarySurfaceBrush}"
                                                                        Visibility="{Binding IsMonitored, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Style="{StaticResource BadgeText}"
                                                                               Foreground="{DynamicResource BrandPrimaryTextBrush}"
                                                                               Text="{x:Static res:Strings.BadgeMonitored}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Style="{StaticResource TableCellText}" Margin="0,0,8,0" Text="{Binding WingetId}" />
                                                            <TextBlock Grid.Column="2" Style="{StaticResource TableCellText}" Margin="0,0,8,0" Text="{Binding Version}" />
                                                            <TextBlock Grid.Column="3" Style="{StaticResource TableCellText}" Text="{Binding Available}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
