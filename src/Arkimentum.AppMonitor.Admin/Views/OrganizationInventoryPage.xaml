<UserControl x:Class="Arkimentum.AppMonitor.Admin.Views.OrganizationInventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Arkimentum.AppMonitor.Admin.Resources"
             FontFamily="{StaticResource AppFontFamily}"
             Foreground="{DynamicResource BrandInkBrush}">

    <!-- The fleet's own application list. Ticking rows and pressing "Add to organization configuration" puts them in
         the organization editor exactly as the local Discover dialog puts them in the registry editor — nothing is
         sent to the server until Publish. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource CaptionText}" MaxWidth="700" HorizontalAlignment="Left" Text="{Binding Subtitle}" />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      Style="{StaticResource ToggleSwitch}"
                      Content="{Binding OnlyUnmonitoredText}"
                      IsChecked="{Binding OnlyUnmonitored, Mode=TwoWay}" />
        </Grid>

        <!-- ==== toolbar -->
        <Grid Grid.Row="1" Margin="4,0,4,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         ToolTip="{x:Static res:Strings.InventoryFilterPlaceholder}"
                         AutomationProperties.Name="{x:Static res:Strings.InventoryFilterPlaceholder}" />
                <TextBlock Style="{StaticResource TertiaryCaptionText}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Text="{x:Static res:Strings.InventoryFilterPlaceholder}"
                           Visibility="{Binding Filter, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Padding="12,6" FontSize="13"
                        Style="{DynamicResource AccentButtonStyle}"
                        Content="{x:Static res:Strings.ButtonAddToOrganization}"
                        ToolTip="{x:Static res:Strings.TipAddToOrganization}"
                        Command="{Binding AddToOrganizationCommand}" />
                <Button Margin="8,0,0,0" Padding="8,6"
                        Command="{Binding RefreshCommand}"
                        ToolTip="{x:Static res:Strings.ButtonRefresh}"
                        AutomationProperties.Name="{x:Static res:Strings.ButtonRefresh}">
                    <TextBlock Style="{StaticResource SymbolGlyph}"
                               FontSize="14"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               Text="{x:Static res:Strings.GlyphRefresh}" />
                </Button>
                <TextBlock Style="{StaticResource CaptionText}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding SelectedText}" />
            </StackPanel>
        </Grid>

        <!-- ==== banners -->
        <StackPanel Grid.Row="2" Margin="4,0,4,12">
            <Border Style="{StaticResource InfoBanner}"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource CaptionText}" Text="{x:Static res:Strings.SignInFirst}" />
            </Border>
            <Border Style="{StaticResource CriticalBanner}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource BrandTerracottaTextBrush}"
                           Text="{Binding Error}" />
            </Border>
            <TextBlock Style="{StaticResource SuccessText}"
                       Text="{Binding Notice}"
                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- ==== the list -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="4,0,4,24"
                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="2.6*" MinWidth="180" />
                        <ColumnDefinition Width="1.6*" MinWidth="120" />
                        <ColumnDefinition Width="2*" MinWidth="140" />
                        <ColumnDefinition Width="*" MinWidth="90" />
                        <ColumnDefinition Width="2*" MinWidth="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnApplication}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnPublisher}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnWingetId}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnDevices}" />
                    <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderText}" Text="{x:Static res:Strings.ColumnVersions}" />
                </Grid>

                <TextBlock Grid.Row="1"
                           Style="{StaticResource TertiaryCaptionText}"
                           Text="{x:Static res:Strings.InventoryEmpty}"
                           Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="2.6*" MinWidth="180" />
                                            <ColumnDefinition Width="1.6*" MinWidth="120" />
                                            <ColumnDefinition Width="2*" MinWidth="140" />
                                            <ColumnDefinition Width="*" MinWidth="90" />
                                            <ColumnDefinition Width="2*" MinWidth="150" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  AutomationProperties.Name="{Binding DisplayName}" />

                                        <!-- Name on its own line, badges and the update count wrapping underneath, so a
                                             long application name never pushes a badge out of the column. -->
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource TableCellText}" FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" />
                                            <WrapPanel Margin="0,3,0,0">
                                                <Border Style="{StaticResource Badge}"
                                                        Margin="0,0,4,0"
                                                        Background="{DynamicResource BrandPrimarySurfaceBrush}"
                                                        Visibility="{Binding IsMonitored, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource BadgeText}"
                                                               Foreground="{DynamicResource BrandPrimaryTextBrush}"
                                                               Text="{Binding MonitoredBadge}" />
                                                </Border>
                                                <Border Style="{StaticResource Badge}"
                                                        Margin="0,0,4,0"
                                                        Background="{DynamicResource BrandSkySurfaceBrush}"
                                                        Visibility="{Binding IsInCatalog, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource BadgeText}"
                                                               Foreground="{DynamicResource BrandSkyTextBrush}"
                                                               Text="{Binding CatalogBadge}" />
                                                </Border>
                                                <TextBlock Style="{StaticResource ErrorText}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrandGoldTextBrush}"
                                                           Text="{Binding UpdatesText}"
                                                           Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Style="{StaticResource TableCellText}" Margin="0,0,8,0" Text="{Binding Publisher}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource TableCellText}" Margin="0,0,8,0" Text="{Binding WingetId}" ToolTip="{Binding WingetId}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource TableCellText}" Margin="0,0,8,0" Text="{Binding DeviceCount}" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource TableCellText}" Text="{Binding Versions}" ToolTip="{Binding Versions}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
