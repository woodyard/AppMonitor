<UserControl x:Class="Arkimentum.AppMonitor.Admin.Views.OrganizationSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Arkimentum.AppMonitor.Admin.Resources"
             FontFamily="{StaticResource AppFontFamily}"
             Foreground="{DynamicResource BrandInkBrush}">

    <!-- The same generated rows as the Settings page (SettingGroupTemplate over SettingsSchema.Global), bound to the
         organization document instead of the registry. The version history below is the only thing this page adds. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,12,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource CaptionText}" MaxWidth="660" HorizontalAlignment="Left" Text="{Binding Subtitle}" />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      Style="{StaticResource ToggleSwitch}"
                      Content="{Binding ShowAdvancedText}"
                      IsChecked="{Binding ShowAdvanced, Mode=TwoWay}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="4,0,4,12">
            <Border Style="{StaticResource InfoBanner}"
                    Visibility="{Binding Configuration.HasDocument, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource CaptionText}" Text="{x:Static res:Strings.OrganizationNotLoaded}" />
            </Border>
            <Border Style="{StaticResource CriticalBanner}"
                    Visibility="{Binding Configuration.HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource BrandTerracottaTextBrush}"
                           Text="{Binding Configuration.Error}" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel Margin="4,0,4,24">
                <ItemsControl ItemsSource="{Binding Editor.GlobalGroups}" ItemTemplate="{StaticResource SettingGroupTemplate}" />

                <!-- ==== version history -->
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource CardTitleText}" Text="{x:Static res:Strings.CardVersionHistory}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource TertiaryCaptionText}" Text="{Binding Configuration.HistoryCountText}" />
                                <TextBlock Style="{StaticResource TertiaryCaptionText}" Margin="12,0,0,0" Text="{Binding Configuration.VersionText}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,8"
                                   MaxWidth="700"
                                   HorizontalAlignment="Left"
                                   Text="{x:Static res:Strings.VersionHistoryCaption}" />

                        <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                   Text="{x:Static res:Strings.VersionHistoryEmpty}"
                                   Visibility="{Binding Configuration.HasHistory, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <ItemsControl ItemsSource="{Binding Configuration.History}"
                                      Visibility="{Binding Configuration.HasHistory, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" MinWidth="110" />
                                                <ColumnDefinition Width="1.8*" MinWidth="150" />
                                                <ColumnDefinition Width="2.4*" MinWidth="170" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource TableCellText}" FontWeight="SemiBold" Text="{Binding ConfigVersion}" />
                                                <Border Style="{StaticResource Badge}"
                                                        Margin="6,0,0,0"
                                                        Background="{DynamicResource BrandSkySurfaceBrush}"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource BadgeText}"
                                                               Foreground="{DynamicResource BrandSkyTextBrush}"
                                                               Text="{x:Static res:Strings.BadgeOrganization}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource TableCellText}" Margin="0,0,8,0"
                                                       ToolTip="{Binding When}" Text="{Binding By}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource TableCellText}" Margin="0,0,8,0"
                                                       ToolTip="{Binding Comment}" Text="{Binding Comment}" />
                                            <!-- Restoring only loads the revision into the editor; the Publish in the
                                                 footer is what writes it, and it writes over the CURRENT version. -->
                                            <Button Grid.Column="3"
                                                    Style="{StaticResource RowLinkButton}"
                                                    VerticalAlignment="Center"
                                                    Content="{x:Static res:Strings.ButtonRestoreVersion}"
                                                    ToolTip="{x:Static res:Strings.TipRestoreVersion}"
                                                    Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.Configuration.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding ConfigVersion}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
