<UserControl x:Class="Arkimentum.AppMonitor.Admin.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFontFamily}"
             Foreground="{DynamicResource BrandInkBrush}">

    <!-- Every row on this page is generated from SettingsSchema.Global; nothing here names an individual setting. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,12,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource CaptionText}" MaxWidth="640" HorizontalAlignment="Left" Text="{Binding Subtitle}" />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      Style="{StaticResource ToggleSwitch}"
                      Content="{Binding ShowAdvancedText}"
                      IsChecked="{Binding ShowAdvanced, Mode=TwoWay}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <ItemsControl Margin="4,0,4,24"
                          ItemsSource="{Binding Editor.GlobalGroups}"
                          ItemTemplate="{StaticResource SettingGroupTemplate}" />
        </ScrollViewer>
    </Grid>
</UserControl>
