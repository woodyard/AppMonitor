<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Arkimentum.AppMonitor.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="System.Management.Automation" Version="7.6.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Arkimentum.AppMonitor.Core\Arkimentum.AppMonitor.Core.csproj" />
    <ProjectReference Include="..\Arkimentum.AppMonitor.Service\Arkimentum.AppMonitor.Service.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The admin console cannot be referenced as a project: it is WPF and targets a Windows SDK version this test
         project does not. Its WPF-free pieces - the command line and the navigation rail - are compiled in here
         instead, so the console's own logic is covered without dragging PresentationFramework into the test host.
         Strings.cs comes along because the rail labels the groups from it. -->
    <Compile Include="..\Arkimentum.AppMonitor.Admin\Infrastructure\CommandLineOptions.cs" Link="Admin\CommandLineOptions.cs" />
    <Compile Include="..\Arkimentum.AppMonitor.Admin\Resources\Strings.cs" Link="Admin\Strings.cs" />
    <Compile Include="..\Arkimentum.AppMonitor.Admin\ViewModels\NavigationRail.cs" Link="Admin\NavigationRail.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tray agent is WPF too; its WPF-free rules are compiled in the same way, with its strings for the banner text. -->
    <Compile Include="..\Arkimentum.AppMonitor.Tray\Services\ScanActivity.cs" Link="Tray\ScanActivity.cs" />
    <Compile Include="..\Arkimentum.AppMonitor.Tray\Services\InstallRound.cs" Link="Tray\InstallRound.cs" />
    <Compile Include="..\Arkimentum.AppMonitor.Tray\Resources\Strings.cs" Link="Tray\Strings.cs" />
    <Compile Include="..\Arkimentum.AppMonitor.Tray\Services\AppIconLookup.cs" Link="Tray\AppIconLookup.cs" />
  </ItemGroup>
</Project>
