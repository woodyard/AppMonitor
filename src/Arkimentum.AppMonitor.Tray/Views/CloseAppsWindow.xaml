<Window x:Class="Arkimentum.AppMonitor.Tray.Views.CloseAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Arkimentum.AppMonitor.Tray.Resources"
        xmlns:ui="clr-namespace:Arkimentum.AppMonitor.UI;assembly=Arkimentum.AppMonitor.UI"
        Title="{Binding Title}"
        Width="480"
        SizeToContent="Height"
        MinHeight="240"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding ForceClosePending, Mode=OneWay}"
        Icon="pack://application:,,,/Arkimentum.AppMonitor.UI;component/Assets/app.ico"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{DynamicResource BrandInkBrush}"
        Background="{DynamicResource BrandBackgroundBrush}">

    <StackPanel Margin="24,20,24,20">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Style="{StaticResource BrandRule}" Width="24" Background="{DynamicResource BrandTerracottaBrush}" />
            <Border Style="{StaticResource BrandRule}" Width="24" Margin="4,0,0,0" Background="{DynamicResource BrandSkyBrush}" />
        </StackPanel>

        <TextBlock Style="{StaticResource SubtitleText}"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   Text="{Binding Title}" />

        <TextBlock Style="{StaticResource TertiaryCaptionText}"
                   Margin="0,4,0,0"
                   Text="{Binding VersionText}" />

        <TextBlock Style="{StaticResource BodyText}"
                   Margin="0,16,0,0"
                   Text="{Binding IntroText}" />

        <Border Style="{StaticResource SubtleCard}" Margin="0,12,0,0" Padding="16,12">
            <ItemsControl ItemsSource="{Binding Processes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource SymbolGlyph}"
                                       FontSize="14"
                                       Margin="0,1,8,0"
                                       Foreground="{DynamicResource BrandPrimaryTextBrush}"
                                       Text="&#xE7C4;" />
                            <!-- The qualifier goes on its own line so a long window title cannot squeeze it out. -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource BodyText}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding FriendlyName}" />
                                <!-- elevated / another session: this agent cannot close those, the service will -->
                                <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                           Margin="0,2,0,0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource BrandTerracottaTextBrush}"
                                           Text="{Binding Qualifier}"
                                           Visibility="{Binding HasQualifier, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource TertiaryCaptionText}"
                                       Margin="8,2,0,0"
                                       TextWrapping="NoWrap"
                                       Text="{Binding ProcessName}"
                                       Visibility="{Binding ShowProcessName, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Style="{StaticResource CaptionText}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding ServiceCloseHint}"
                   Visibility="{Binding ShowServiceCloseHint, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Style="{StaticResource CaptionText}"
                   Margin="0,12,0,0"
                   Text="{x:Static res:Strings.CloseAppsSaveHint}" />

        <!-- forced-close countdown: terracotta while a forced close is pending -->
        <Border Style="{StaticResource CriticalBanner}"
                Margin="0,16,0,0"
                Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SymbolGlyph}"
                           FontSize="16"
                           Margin="0,1,12,0"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource BrandTerracottaTextBrush}"
                           Text="&#xE916;" />
                <TextBlock Style="{StaticResource BodyStrongText}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           MaxWidth="368"
                           Foreground="{DynamicResource BrandTerracottaTextBrush}"
                           Text="{Binding CountdownText}" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource CaptionText}"
                   Margin="0,12,0,0"
                   Foreground="{DynamicResource BrandGoldTextBrush}"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

        <!-- actions -->
        <WrapPanel Margin="0,24,0,0" HorizontalAlignment="Right">
            <Button MinWidth="168"
                    Margin="0,0,8,0"
                    Padding="16,8"
                    Style="{DynamicResource AccentButtonStyle}"
                    Content="{x:Static res:Strings.CloseAppsAndUpdate}"
                    Command="{Binding CloseAndUpdateCommand}" />

            <Button Margin="0,0,8,0"
                    Padding="16,8"
                    ui:DropDownButton.OpensMenu="True"
                    Visibility="{Binding ShowDefer, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.Defer}" />
                    <TextBlock Style="{StaticResource SymbolGlyph}"
                               FontSize="10"
                               Margin="8,3,0,0"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                               Text="&#xE70D;" />
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu ItemsSource="{Binding DeferralOptions}">
                        <ContextMenu.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Label}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                            </Style>
                        </ContextMenu.ItemContainerStyle>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Button MinWidth="96"
                    Padding="16,8"
                    Content="{x:Static res:Strings.CloseAppsNotNow}"
                    Command="{Binding NotNowCommand}"
                    Visibility="{Binding ShowNotNow, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>
    </StackPanel>
</Window>
