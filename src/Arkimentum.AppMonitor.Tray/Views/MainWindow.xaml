<Window x:Class="Arkimentum.AppMonitor.Tray.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Arkimentum.AppMonitor.Tray.Resources"
        xmlns:ui="clr-namespace:Arkimentum.AppMonitor.UI;assembly=Arkimentum.AppMonitor.UI"
        Title="{Binding Title}"
        Width="560"
        Height="680"
        MinWidth="440"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Arkimentum.AppMonitor.UI;component/Assets/app.ico"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{DynamicResource BrandInkBrush}"
        Background="{DynamicResource BrandBackgroundBrush}">

    <Grid x:Name="LayoutRoot" Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- The update list keeps some room even with both expanders open in a small window. -->
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==== header: wordmark, status line, primary action -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand bars, wordmark and product word come from the shared UI library. -->
            <ui:BrandHeader Grid.Column="0"
                            VerticalAlignment="Center"
                            BrandName="{x:Static res:Strings.WordmarkBrand}"
                            ProductName="{x:Static res:Strings.WordmarkProduct}"
                            Subtitle="{Binding StatusLine}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <!-- Queues every installable update at once; only shown while there is something to install. -->
                <Button MinWidth="112"
                        Margin="0,0,8,0"
                        Padding="16,8"
                        Style="{DynamicResource AccentButtonStyle}"
                        Content="{Binding UpdateAllText}"
                        Command="{Binding UpdateAllCommand}"
                        Visibility="{Binding ShowUpdateAll, Converter={StaticResource BoolToVisibility}}" />
                <Button MinWidth="112"
                        Padding="16,8"
                        Style="{DynamicResource AccentButtonStyle}"
                        Content="{x:Static res:Strings.CheckNow}"
                        Command="{Binding CheckNowCommand}" />
            </StackPanel>
        </Grid>

        <!-- ==== banners: connection state and install progress, stacked so either can be hidden -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Banner}"
                    Margin="0,0,0,16"
                    Visibility="{Binding ShowDisconnectedBanner, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SymbolGlyph}"
                               FontSize="16"
                               Margin="0,1,12,0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource BrandGoldTextBrush}"
                               Text="&#xE7BA;" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyStrongText}"
                                   Foreground="{DynamicResource BrandGoldTextBrush}"
                                   Text="{x:Static res:Strings.DisconnectedBanner}" />
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0"
                                   MaxWidth="400"
                                   HorizontalAlignment="Left"
                                   Text="{x:Static res:Strings.DisconnectedBannerDetail}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Progress while the service works through queued updates; indeterminate because installers report no percentage. -->
            <Border Style="{StaticResource InfoBanner}"
                    Margin="0,0,0,16"
                    Visibility="{Binding ShowProgressBanner, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource BrandSkyTextBrush}"
                               Text="{Binding ProgressText}" />
                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Margin="0,10,0,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource BrandSkyBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ==== update list -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,8,0"
                          Margin="-4,-4,-4,0"
                          Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <ItemsControl ItemsSource="{Binding Updates}" Margin="4,4,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource UpdateCard}" Margin="0,0,0,12">
                                <StackPanel>

                                    <!-- name + badges -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource BodyStrongText}"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="{Binding DisplayName}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource SourceBadge}" Margin="0,0,4,0">
                                                <TextBlock Style="{StaticResource SourceBadgeText}" Text="{Binding SourceBadge}" />
                                            </Border>
                                            <Border Style="{StaticResource ContextBadge}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding ContextBadge}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                               Margin="0,4,0,0"
                                               Text="{Binding VersionText}" />

                                    <TextBlock Style="{StaticResource StatusText}"
                                               Margin="0,8,0,0"
                                               Text="{Binding StatusText}" />

                                    <TextBlock Style="{StaticResource DeadlineText}"
                                               Margin="0,4,0,0"
                                               Text="{Binding DeadlineText}"
                                               Visibility="{Binding HasDeadline, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- actions -->
                                    <WrapPanel Margin="0,16,0,0"
                                               Visibility="{Binding ShowAnyAction, Converter={StaticResource BoolToVisibility}}">
                                        <Button MinWidth="104"
                                                Margin="0,0,8,0"
                                                Padding="14,6"
                                                Style="{DynamicResource AccentButtonStyle}"
                                                Content="{x:Static res:Strings.InstallNow}"
                                                Command="{Binding InstallCommand}"
                                                Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- Brings the close-apps dialog back: the user may have closed it with its X. -->
                                        <Button MinWidth="168"
                                                Margin="0,0,8,0"
                                                Padding="14,6"
                                                Style="{DynamicResource AccentButtonStyle}"
                                                Content="{x:Static res:Strings.CloseAppsAndUpdate}"
                                                Command="{Binding CloseAppsCommand}"
                                                Visibility="{Binding ShowCloseApps, Converter={StaticResource BoolToVisibility}}" />

                                        <Button Margin="0,0,8,0"
                                                Padding="14,6"
                                                ui:DropDownButton.OpensMenu="True"
                                                Visibility="{Binding ShowDefer, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Static res:Strings.Defer}" />
                                                <TextBlock Style="{StaticResource SymbolGlyph}"
                                                           FontSize="10"
                                                           Margin="8,3,0,0"
                                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                           Text="&#xE70D;" />
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu ItemsSource="{Binding DeferralOptions}">
                                                    <ContextMenu.ItemContainerStyle>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Header" Value="{Binding Label}" />
                                                            <Setter Property="Command" Value="{Binding Command}" />
                                                        </Style>
                                                    </ContextMenu.ItemContainerStyle>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>

                                        <Button Margin="0,0,8,0"
                                                Padding="14,6"
                                                Content="{x:Static res:Strings.RemindMeLater}"
                                                Command="{Binding DismissCommand}"
                                                Visibility="{Binding ShowRemindMeLater, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                                   VerticalAlignment="Center"
                                                   Text="{x:Static res:Strings.NoMoreDeferrals}"
                                                   Visibility="{Binding ShowNoMoreDeferrals, Converter={StaticResource BoolToVisibility}}" />
                                    </WrapPanel>

                                    <TextBlock Style="{StaticResource TertiaryCaptionText}"
                                               Margin="0,8,0,0"
                                               Text="{Binding DeferralsUsedText}"
                                               Visibility="{Binding DeferralsUsedText, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ==== empty state -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,32"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <Border Width="96"
                        Height="96"
                        CornerRadius="48"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource BrandPrimarySurfaceBrush}">
                    <TextBlock Style="{StaticResource SymbolGlyph}"
                               FontSize="40"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BrandPrimaryTextBrush}"
                               Text="{Binding EmptyGlyph}" />
                </Border>
                <TextBlock Style="{StaticResource SubtitleText}"
                           Margin="0,24,0,0"
                           HorizontalAlignment="Center"
                           Text="{x:Static res:Strings.EmptyTitle}" />
                <TextBlock Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0"
                           MaxWidth="320"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Text="{Binding EmptySubtitle}" />
            </StackPanel>
        </Grid>

        <!-- ==== recent updates: one line per finished install, newest first (the service sends at most 10) -->
        <!-- ==== recent updates and details: one panel that scrolls when both are open. The window caps its height so the
             update list above always keeps its row's MinHeight (see MainWindow.FitLowerSection). -->
        <ScrollViewer x:Name="LowerSection"
                      Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <Expander Expanded="OnSectionExpanded"
                  Margin="0,16,0,0"
                  Foreground="{DynamicResource BrandInkBrush}"
                  Header="{x:Static res:Strings.RecentInstallsHeader}"
                  IsExpanded="{Binding RecentInstallsExpanded, Mode=TwoWay}">
            <StackPanel Margin="0,12,0,4">
                <TextBlock Style="{StaticResource CaptionText}"
                           Text="{x:Static res:Strings.RecentInstallsEmpty}"
                           Visibility="{Binding ShowRecentInstallsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding RecentInstalls}"
                              Focusable="False"
                              Visibility="{Binding ShowRecentInstallsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,4" Background="Transparent" ToolTip="{Binding ToolTip}">
                                <TextBlock DockPanel.Dock="Left"
                                           Width="16"
                                           Margin="0,0,8,0"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{Binding Glyph}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolGlyph}">
                                            <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrandTerracottaTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Right"
                                           Style="{StaticResource CaptionText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           Text="{Binding TimeText}" />
                                <!-- Name and version share one trimmed line, so a long name never wraps the row. -->
                                <TextBlock Style="{StaticResource BodyText}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                    <Run Text="{Binding VersionText, Mode=OneWay}"
                                         FontSize="12"
                                         Foreground="{DynamicResource BrandSubtleTextBrush}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>

        <!-- ==== details footer -->
        <Expander Expanded="OnSectionExpanded"
                  Margin="0,16,0,0"
                  Foreground="{DynamicResource BrandInkBrush}"
                  Header="{x:Static res:Strings.DetailsHeader}">
            <Grid Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="144" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="{x:Static res:Strings.DetailsOrganization}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding OrganizationText}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0" Text="{x:Static res:Strings.DetailsScanInterval}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,8,0,0" Text="{Binding ScanIntervalText}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0" Text="{x:Static res:Strings.DetailsNotificationInterval}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,8,0,0" Text="{Binding NotificationIntervalText}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0" Text="{x:Static res:Strings.DetailsSources}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,8,0,0" Text="{Binding SourcesText}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0" Text="{x:Static res:Strings.DetailsNotifications}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,8,0,0" Text="{Binding NotificationsText}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0" Text="{x:Static res:Strings.DetailsMonitoredApps}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,8,0,0" Text="{Binding MonitoredAppsText}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0" Text="{x:Static res:Strings.DetailsLogFolder}" />
                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource DetailValue}" Text="{Binding LogDirectory}" TextWrapping="Wrap" />
                    <Button Style="{StaticResource LinkButton}"
                            Margin="0,4,0,0"
                            Content="{x:Static res:Strings.DetailsOpen}"
                            Command="{Binding OpenLogFolderCommand}" />
                </StackPanel>

                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0" Text="{x:Static res:Strings.DetailsServiceVersion}" />
                <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource DetailValue}" Margin="0,8,0,0" Text="{Binding ServiceVersion}" />

                <!-- The agent's own update: the version, what the last check concluded, and the two actions. -->
                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource DetailLabel}" Margin="0,8,16,0" Text="{x:Static res:Strings.DetailsAgentVersion}" />
                <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource DetailValue}" TextWrapping="Wrap" Text="{Binding AgentUpdate.VersionText}" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,0,0"
                                Visibility="{Binding AgentUpdate.ShowActions, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource LinkButton}"
                                Content="{x:Static res:Strings.AgentCheckForUpdates}"
                                Command="{Binding AgentUpdate.CheckCommand}" />
                        <Button Margin="12,0,0,0"
                                Padding="12,4"
                                Style="{DynamicResource AccentButtonStyle}"
                                Content="{x:Static res:Strings.AgentUpdateNow}"
                                Command="{Binding AgentUpdate.UpdateNowCommand}"
                                Visibility="{Binding AgentUpdate.ShowUpdateNow, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding AgentUpdate.Notice}"
                               Visibility="{Binding AgentUpdate.HasNotice, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Expander>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
