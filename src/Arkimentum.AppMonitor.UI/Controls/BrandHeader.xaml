<UserControl x:Class="Arkimentum.AppMonitor.UI.BrandHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- The Arkimentum wordmark block: two brand bars, "Arkimentum" in Gelasio olive, the letter-spaced
         terracotta product word, and an optional caption line.

         Styles.xaml is merged here as well as (normally) in the host's App.xaml so the control is self-contained:
         every key below is keyed, so nothing implicit leaks into the host's visual tree. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Arkimentum.AppMonitor.UI;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- the two brand bars of the favicon: terracotta, then sky -->
        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,8"
                    Visibility="{Binding ShowBrandRule, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource BrandRule}"
                    Width="{Binding BrandRuleWidth, ElementName=Root}"
                    Background="{DynamicResource BrandTerracottaBrush}" />
            <Border Style="{StaticResource BrandRule}"
                    Width="{Binding BrandRuleWidth, ElementName=Root}"
                    Margin="4,0,0,0"
                    Background="{DynamicResource BrandSkyBrush}" />
        </StackPanel>

        <TextBlock Style="{StaticResource WordmarkText}"
                   FontSize="{Binding WordmarkFontSize, ElementName=Root}"
                   Text="{Binding BrandName, ElementName=Root}" />

        <TextBlock Style="{StaticResource ProductMarkText}"
                   Margin="0,2,0,0"
                   Text="{Binding ProductName, ElementName=Root, Converter={StaticResource LetterSpacing}}"
                   Visibility="{Binding ProductName, ElementName=Root, Converter={StaticResource StringToVisibility}}" />

        <TextBlock Style="{StaticResource CaptionText}"
                   Margin="{Binding SubtitleMargin, ElementName=Root}"
                   Text="{Binding Subtitle, ElementName=Root}"
                   Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource StringToVisibility}}" />
    </StackPanel>
</UserControl>
