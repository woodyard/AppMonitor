<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Arkimentum brand palette — DARK. Key-for-key identical to Brand.Light.xaml; see that file for what the
        two halves (Brand* tokens, Fluent overrides) are for. In dark the primary shifts from olive to the brand
        gold, which is what the web sites do, and the olive survives as the wordmark / success colour.
    -->

    <!-- ==================================================== brand tokens -->

    <Color x:Key="BrandBackgroundColor">#1F221A</Color>
    <Color x:Key="BrandCardColor">#2A2E22</Color>
    <Color x:Key="BrandInkColor">#ECECEC</Color>
    <Color x:Key="BrandBorderColor">#3D4233</Color>
    <Color x:Key="BrandPrimaryColor">#C7CA5C</Color>
    <Color x:Key="BrandPrimaryFillColor">#C7CA5C</Color>
    <Color x:Key="BrandPrimaryGlowColor">#9AA86A</Color>
    <Color x:Key="BrandTerracottaColor">#C76239</Color>
    <Color x:Key="BrandGoldColor">#C7CA5C</Color>
    <Color x:Key="BrandSkyColor">#389DC6</Color>

    <!-- grounds -->
    <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#1F221A" />
    <SolidColorBrush x:Key="BrandCardBrush" Color="#2A2E22" />
    <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#2F3328" />
    <SolidColorBrush x:Key="BrandAccentSurfaceBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="BrandBorderBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="BrandBorderStrongBrush" Color="#4B5140" />

    <!-- ink -->
    <SolidColorBrush x:Key="BrandInkBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="BrandMutedBrush" Color="#C2C4B8" />
    <SolidColorBrush x:Key="BrandSubtleTextBrush" Color="#B0B2A5" />
    <SolidColorBrush x:Key="BrandMutedStrongBrush" Color="#D3D5C8" />

    <!-- olive / gold primary -->
    <SolidColorBrush x:Key="BrandWordmarkBrush" Color="#9AA86A" />
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#C7CA5C" />
    <SolidColorBrush x:Key="BrandPrimaryFillBrush" Color="#C7CA5C" />
    <SolidColorBrush x:Key="BrandPrimaryFillHoverBrush" Color="#D4D76F" />
    <SolidColorBrush x:Key="BrandPrimaryFillPressedBrush" Color="#B0B34B" />
    <SolidColorBrush x:Key="BrandOnPrimaryBrush" Color="#1F221A" />
    <SolidColorBrush x:Key="BrandPrimaryTextBrush" Color="#AEBA7E" />
    <SolidColorBrush x:Key="BrandPrimarySurfaceBrush" Color="#333A24" />

    <!-- terracotta: destructive / mandatory / deadline -->
    <SolidColorBrush x:Key="BrandTerracottaBrush" Color="#C76239" />
    <SolidColorBrush x:Key="BrandTerracottaTextBrush" Color="#E08A5F" />
    <SolidColorBrush x:Key="BrandTerracottaSurfaceBrush" Color="#3C2A22" />

    <!-- gold: deferred / waiting / caution -->
    <SolidColorBrush x:Key="BrandGoldBrush" Color="#C7CA5C" />
    <SolidColorBrush x:Key="BrandGoldTextBrush" Color="#C7CA5C" />
    <SolidColorBrush x:Key="BrandGoldSurfaceBrush" Color="#3A3A20" />

    <!-- sky: informational -->
    <SolidColorBrush x:Key="BrandSkyBrush" Color="#389DC6" />
    <SolidColorBrush x:Key="BrandSkyTextBrush" Color="#86C9E6" />
    <SolidColorBrush x:Key="BrandSkySurfaceBrush" Color="#253C46" />

    <DropShadowEffect x:Key="BrandCardShadow" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000" />
    <DropShadowEffect x:Key="BrandCardShadowStrong" BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#000000" />

    <!-- ==================================================== Fluent overrides -->

    <!-- window / layer grounds -->
    <Color x:Key="ApplicationBackgroundColor">#1F221A</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#1F221A" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#1F221A" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="#171A12" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#2F3328" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#2A2E22" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#343930" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#2A2E22" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#2A2E22" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#2A2E22" />

    <!-- cards -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2A2E22" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#2F3328" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3D4233" />

    <!-- text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C2C4B8" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#B0B2A5" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#787C6C" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#1F221A" />

    <!-- controls -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#343930" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#2F3328" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#282C21" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#1F221A" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="#2A2E22" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#2F3328" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="#4B5140" />

    <!-- strokes -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#4B5140" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#B0B2A5" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="CircleElevationBorderBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#2A2E22" />

    <!-- accent = brand gold -->
    <Color x:Key="SystemAccentColor">#C7CA5C</Color>
    <Color x:Key="SystemAccentColorLight1">#D4D76F</Color>
    <Color x:Key="SystemAccentColorLight2">#DFE18C</Color>
    <Color x:Key="SystemAccentColorLight3">#EAECB3</Color>
    <Color x:Key="SystemAccentColorDark1">#B0B34B</Color>
    <Color x:Key="SystemAccentColorDark2">#9AA86A</Color>
    <Color x:Key="SystemAccentColorDark3">#7A894A</Color>

    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#C7CA5C" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#D4D76F" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B0B34B" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#7A894A" />

    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1F221A" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#D81F221A" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#787C6C" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#ECECEC" />

    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#C7CA5C" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#D4D76F" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#AEBA7E" />
    <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#787C6C" />

    <SolidColorBrush x:Key="AccentButtonBackground" Color="#C7CA5C" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#D4D76F" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#B0B34B" />
    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#3D4233" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#1F221A" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1F221A" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#D81F221A" />
    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#787C6C" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#D4D76F" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#DFE18C" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#00000000" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#D4D76F" />

    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="#33000000" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentTertiaryBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDisabledBrush" Color="#0FFFFFFF" />

    <!-- focus ring -->
    <Color x:Key="KeyboardFocusBorderColor">#C7CA5C</Color>
    <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="#C7CA5C" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#C7CA5C" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#1F221A" />

    <!-- text input -->
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#C7CA5C" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#C7CA5C" />

    <!-- status fills -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#AEBA7E" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#333A24" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#C7CA5C" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#3A3A20" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#E08A5F" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#3C2A22" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#86C9E6" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#253C46" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#C2C4B8" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#2F3328" />
    <SolidColorBrush x:Key="SystemFillColorSolidNeutralBackgroundBrush" Color="#2F3328" />
    <SolidColorBrush x:Key="SystemFillColorSolidNeutralBrush" Color="#C2C4B8" />

    <!-- subtle (hover) fills pick up a whisper of gold -->
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#26C7CA5C" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#1AC7CA5C" />

    <!-- expander / scrollbar -->
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#2A2E22" />
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#262A1F" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#3D4233" />
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#6C7160" />
    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#99000000" />

</ResourceDictionary>
